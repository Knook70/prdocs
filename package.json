{
  "name": "prdocs",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11.6.1"
  },
  "version": "0.2.0",
  "scripts": {
    "dev": "node src/site-build/run.ts dev",
    "build": "tsc && node src/site-build/run.ts build",
    "pr:check": "node scripts/pr/check.ts",
    "pr": "npm run pr:check && node scripts/pr/submit.ts",
    "test:types": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.9",
    "sitemap": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
